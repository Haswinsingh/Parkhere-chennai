# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
# Provide standard MongoDB URI (e.g. mongodb://127.0.0.1:27017/parkhere or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/parkhere

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_parkhere_production_2026_secure
JWT_EXPIRES_IN=7d

# File Storage
STORAGE_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payments
UPI_PROVIDER_CONFIG=
PAYMENT_SECRET=

# Geofence Settings
ARRIVAL_RADIUS_METERS=100
