# PARKHERE - ENVIRONMENT CONFIGURATION
# Copy to .env in backend/ and frontend/ as appropriate

# BACKEND (.env in /backend)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB connection string or local URI)
MONGODB_URI=mongodb://127.0.0.1:27017/parkhere

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_parkhere_production_2026_secure
JWT_EXPIRES_IN=7d

# Private & Protected Storage
STORAGE_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payments & Gateways
UPI_PROVIDER_CONFIG=
PAYMENT_SECRET=

# Geofence Settings (Meters)
ARRIVAL_RADIUS_METERS=100

# FRONTEND (.env in /frontend)
VITE_API_URL=http://localhost:5000/api
VITE_MAPTILER_API_KEY=
